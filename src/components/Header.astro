---
interface Props {
    nav?: {
        projects: string;
        education: string;
        contact: string;
    };
}

const {
    nav = { projects: "Projects", education: "Education", contact: "Contact" },
} = Astro.props as Props;
---

<header class="header">
	<div class="container header-content">
		<h2>Kuri</h2>
			<nav class="main-navigation">
				<a href="#selected-projects">{nav.projects}</a>
				<a href="#education">{nav.education}</a>
				<a href="#contact">{nav.contact}</a>
			</nav>
	</div>
</header>
