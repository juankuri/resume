---
// Demo project card: media frame (via <slot />) + benefits + CTA.
import { waHref } from "../../data/portfolio.js";

const { project, projectEn, t, ten, lang = "es" } = Astro.props;
---

<article class="project-card">
    <div class="media">
        <slot />
    </div>
    <div class="body">
        <span class="tag" data-en={projectEn.tag}>{project.tag}</span>
        <h3 data-en={projectEn.title}>{project.title}</h3>
        <p data-en={projectEn.desc}>{project.desc}</p>
        <ul class="benefits">
            {project.features.map((f, i) => (
                <li><span class="check">✓</span><span data-en={projectEn.features[i]}>{f}</span></li>
            ))}
        </ul>
        <a class="ask" href={waHref[lang]} data-en-href={waHref.en} data-en={`${ten.askDemo} →`}>{t.askDemo} →</a>
    </div>
</article>

<style>
    .project-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07);
        border-color: #d6d6d0;
    }

    .media {
        background: var(--warm);
        padding: 24px 24px 0;
        display: flex;
        justify-content: center;
    }

    .body {
        padding: 24px;
    }

    .tag {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--ink-soft);
        font-weight: 600;
    }

    .body h3 {
        margin: 8px 0 0;
        font-size: 1.2rem;
    }

    .body p {
        margin: 10px 0 0;
        font-size: 0.95rem;
    }

    .benefits {
        list-style: none;
        margin: 16px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .benefits li {
        display: flex;
        gap: 9px;
        font-size: 0.9rem;
        color: var(--ink);
    }

    .check {
        color: var(--accent);
        font-weight: 700;
    }

    .ask {
        display: inline-block;
        margin-top: 18px;
        color: var(--accent);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
    }

    .ask:hover {
        color: var(--ink);
    }
</style>
