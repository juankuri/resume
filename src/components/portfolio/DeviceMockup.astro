---
// Reusable device frame for screenshots.
// variant: "browser" (dots bar + screen) | "phone" (rounded bezel)
// The screen content is passed via <slot />.
const { variant = "browser", dots = 3, ratio = "16 / 10" } = Astro.props;
---

{variant === "browser" && (
    <div class="browser">
        <div class="browser-bar">
            {Array.from({ length: dots }).map(() => <span class="dot" />)}
        </div>
        <div class="screen" style={`aspect-ratio:${ratio}`}>
            <slot />
        </div>
    </div>
)}

{variant === "phone" && (
    <div class="phone">
        <div class="screen phone-screen" style={`aspect-ratio:${ratio}`}>
            <slot />
        </div>
    </div>
)}

<style>
    .browser {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.10);
    }

    .browser-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        background: #ecebe8;
        border-bottom: 1px solid var(--line);
    }

    .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.16);
    }

    .phone {
        background: #1a1a1a;
        border-radius: 26px;
        padding: 8px;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
    }

    .screen {
        position: relative;
        background: #fff;
        overflow: hidden;
    }

    .phone-screen {
        border-radius: 19px;
    }

    /* Slotted <img> fills the screen */
    .screen :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Placeholder text when there is no image yet */
    .screen :global(.placeholder) {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 12px;
        font-size: 0.8rem;
        color: var(--ink-soft);
        background: repeating-linear-gradient(
            45deg,
            #f4f3f1,
            #f4f3f1 10px,
            #efeeeb 10px,
            #efeeeb 20px
        );
    }
</style>
