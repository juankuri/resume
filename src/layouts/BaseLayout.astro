---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
    title = "Juan Kuri - Software Engineering Student & Backend Developer",
    description = "Software Engineering student from Mexico specializing in Java, Spring Boot and backend development.",
    lang = "en",
    canonical = new URL(Astro.url.pathname, Astro.site).href,
    image = "/nueva_foto_perfil.webp"
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />

        <title>{title}</title>

        <meta
            name="description"
            content={description}
        />

        <meta property="og:title" content={title} />
        <meta
            property="og:description"
            content={description}
        />
        <meta property="og:image" content={image} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />

        <link id="favicon" rel="icon" type="image/gif" href="/favicon.gif?v=7" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=1" />

        <link
            rel="canonical"
            href={canonical}
        />

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
    </head>

    <body>
        <slot name="header"><Header nav={Astro.props.nav} /></slot>
        <slot />
        <slot name="footer"><Footer /></slot>

        <script>
            const favicon = document.getElementById("favicon") as HTMLLinkElement | null;
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            if (favicon && !reduceMotion) {
                const size = 32;
                const sprite = new Image();
                sprite.src = "/favicon-sprite.png?v=1";

                sprite.addEventListener("load", () => {
                    const count = Math.round(sprite.naturalWidth / size);
                    const canvas = document.createElement("canvas");
                    canvas.width = size;
                    canvas.height = size;

                    const ctx = canvas.getContext("2d");
                    if (!ctx) return;

                    const icons: string[] = [];
                    for (let i = 0; i < count; i++) {
                        ctx.clearRect(0, 0, size, size);
                        ctx.drawImage(sprite, i * size, 0, size, size, 0, 0, size, size);
                        icons.push(canvas.toDataURL("image/png"));
                    }

                    favicon.type = "image/png";
                    const frameMs = 40;
                    const start = performance.now();
                    let current = -1;

                    const tick = (now: number) => {
                        const index = Math.floor((now - start) / frameMs) % icons.length;
                        if (index !== current) {
                            current = index;
                            favicon.href = icons[index];
                        }
                        requestAnimationFrame(tick);
                    };

                    requestAnimationFrame(tick);
                });
            }
        </script>
    </body>
</html>
